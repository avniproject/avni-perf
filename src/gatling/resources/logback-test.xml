<?xml version="1.0" encoding="UTF-8"?>
<configuration>

	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} [%-5level] %logger{15} - %msg%n%rEx</pattern>
		</encoder>
		<immediateFlush>false</immediateFlush>
	</appender>

	<!-- Every failing request logs a full request/response block at DEBUG, and a stress run
	     produces failures in volume by design. Left on, that is injector CPU spent formatting
	     strings about the latency it is supposed to be measuring - the same class of cost as the
	     TRACE logging noted in F2.1 - plus a log nobody can read. Pointed at a closed port with
	     D8.5's spin present it reached 1.4 GB in two minutes.

	     So the default is WARN and the detail is opt-in:
	       -DHTTP_LOG_LEVEL=DEBUG   every failing HTTP request, for debugging a run
	       -DHTTP_LOG_LEVEL=TRACE   every HTTP request -->
	<logger name="io.gatling.http.engine.response" level="${HTTP_LOG_LEVEL:-WARN}" />

	<root level="WARN">
		<appender-ref ref="CONSOLE" />
	</root>

</configuration>
