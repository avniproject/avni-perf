.gradle
build

/.idea/
# User lists. The scenario feeders below are committed: they are generated, they carry no
# password or token, and having them in the tree is what lets a result be traced to the cohort it
# ran as. Everything else stays ignored by default -- a feeder built under AUTH_MODE=cognito
# carries real tokens in `password|token`, and default-allow would make committing those the easy
# path. Un-ignore a new one deliberately, after looking at that column.
/src/gatling/resources/*-users.csv
/src/gatling/resources/sync-users.*.csv
!/src/gatling/resources/sync-users.csv
!/src/gatling/resources/case1-users.csv
# One name per dataset, because two datasets split to the same case numbers. -states is
# states-day-180, -pilot is pilot-day-180 (span 8.4), -span20 is pilot-day-180-span20. Case 1 has
# no dataset -- it is a bootstrap cohort in an organisation holding no field data.
!/src/gatling/resources/case2-users-states.csv
!/src/gatling/resources/case3-users-states.csv
!/src/gatling/resources/case4-users-states.csv
!/src/gatling/resources/case2-users-pilot.csv
!/src/gatling/resources/case3-users-pilot.csv
!/src/gatling/resources/case4-users-pilot.csv
!/src/gatling/resources/case5-users-pilot.csv
!/src/gatling/resources/case3-users-span20.csv
!/src/gatling/resources/case4-users-span20.csv
!/src/gatling/resources/case5-users-span20.csv
!/gradle/wrapper/gradle-wrapper.jar
tools/entity-metadata/node_modules
tools/entity-metadata/package-lock.json

# data generator
tools/data-generator/.venv
tools/data-generator/**/__pycache__

# Local-only: maps the code names and ranks used in this repository to the real production
# organisations they came from. The measurements are publishable; the attribution is not.
*.local.md
