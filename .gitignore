# Real user lists - never commit. The *-example.csv files are the only tracked ones, and they
# do not match the pattern below, so a new cohort file is ignored by default rather than by
# someone remembering to add it. SYNC_USERS and CO_TENANT_USERS name these per run.
/src/gatling/resources/*-users.csv
/src/gatling/resources/sync-users.*.csv
!/gradle/wrapper/gradle-wrapper.jar
tools/entity-metadata/node_modules
tools/entity-metadata/package-lock.json

# data generator
tools/data-generator/.venv
tools/data-generator/**/__pycache__

# Local-only: maps the code names and ranks used in this repository to the real production
# organisations they came from. The measurements are publishable; the attribution is not.
*.local.md
